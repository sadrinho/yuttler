# copy this to .env and fill in real values. never commit .env itself.

# LocationIQ API key for /autocomplete
LOCATIONIQ_KEY=

# comma-separated list of frontend origins allowed by CORS, e.g. http://localhost:5173,https://your-domain.com
ALLOWED_ORIGIN=

# optional: defaults to 3001. most hosts inject this for you
PORT=

# optional: set to exactly 'true' to re-enable the Nominatim fallback. off by default (policy forbids autocomplete use)
ENABLE_NOMINATIM=
